# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is the committed template.
#
# The ledger binary auto-loads .env from the current working directory at
# startup. Real shell env vars take precedence over anything in .env, so
# `ANTHROPIC_API_KEY=... ledger ...` overrides the file for one-off runs.

# --- Required for `ledger generate` ---
# Anthropic API key. Get one at https://console.anthropic.com/settings/keys.
# Only `ledger generate` uses it; `analyse` and `parse` are fully offline.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional ---
# Override the model used by `ledger generate`. Defaults to Haiku 4.5.
# Other reasonable choices: claude-sonnet-4-6, claude-opus-4-7.
# LEDGER_MODEL=claude-haiku-4-5-20251001
