# secrets — .env holds the actual API key, .env.example is the committed template
.env
.env.local

# binaries
/ledger
/bin/
cmd/ledger/ledger

# local SQLite ledger DBs — per-user data, never committed
*.db
*.db-journal
*.db-wal
*.db-shm

# Xcode noise — the project file itself is generated locally per Xcode setup
ios/**/*.xcodeproj
ios/**/*.xcworkspace
ios/**/xcuserdata/
ios/**/DerivedData/
ios/**/build/
ios/**/*.xcuserstate

# real SMS dumps must never be committed
testdata/*.xml
*.dump
*.dump.xml

# editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
